+module TelegramBot
+doc "Telegram bot: webhook OR long-poll intake, photo understanding, bounded video-tool intake, voice transcription, and LLM replies. Three-tier access: admins (admin_user_ids) full, allow-listed users (allowed_user_ids from allowed_path) sandboxed, everyone else ignored. Supports group chats and per-user sandboxing."
+shared telegram_token:String = ""
+shared token_path:String = "/home/marenz/.telegram-bot-token"
+shared allowed_path:String = "/home/marenz/.telegram-bot-users"
+shared admin_user_ids:String = "100000001"
+shared allowed_user_ids:String = ""
+shared sandbox_perm_model:String = "family"
+shared intake_mode:String = "poll"
+shared poll_offset:Int = 0
+shared poll_running:Bool = false

+startup [io,async,mut]
  +await token:String = read_file(token_path)
  +set telegram_token = trim(token)
  +await has_allowed:Bool = file_exists(allowed_path)
  +if has_allowed
    +await raw:String = read_file(allowed_path)
    +set allowed_user_ids = parse_id_list(raw)
  +if intake_mode=="poll"
    +spawn poll_loop()
    +return concat("TelegramBot ready (poll mode), token=", to_string(length(telegram_token)), "ch, admins=", admin_user_ids, ", allowed=", allowed_user_ids)
  +return concat("TelegramBot ready (webhook mode), token=", to_string(length(telegram_token)), "ch, admins=", admin_user_ids, ", allowed=", allowed_user_ids)

+route POST "/webhook/telegram" -> handle_update

+fn parse_id_list (raw:String)->String
  +let lines:List<String> = split(raw, "\n")
  +let out:String = ""
  +let i:Int = 0
  +let n:Int = len(lines)
  +while i<n
    +let line:String = get(lines, i)
    +let cells:List<String> = split(line, ",")
    +let j:Int = 0
    +let m:Int = len(cells)
    +while j<m
      +let tok:String = trim(get(cells, j))
      +if tok!=""
        +if starts_with(tok, "#")==false
          +if out==""
            +set out = tok
          +else
            +set out = concat(out, concat(",", tok))
      +set j = j+1
    +set i = i+1
  +return out
+doc "Normalize an ID file into a comma-separated ID string: accepts newline- and/or comma-separated IDs, trims whitespace, skips blank lines and # comments. Returns empty string if the file yields nothing (caller decides the fallback)."

+test parse_id_list
  +with raw="100000001" -> expect "100000001"
  +with raw="100000001\n999\n" -> expect "100000001,999"
  +with raw="100000001, 999" -> expect "100000001,999"
  +with raw="# admins\n100000001\n\n999\n" -> expect "100000001,999"
  +with raw="" -> expect ""
  +with raw="\n\n" -> expect ""

+fn init (token:String, admins:String)->String [mut]
  +set telegram_token = token
  +set admin_user_ids = admins
  +return "ok"
+doc "Initialize bot with token and comma-separated admin user IDs"

+fn is_admin (user_id:Int)->Bool
  +return is_admin_in(user_id, admin_user_ids)
+doc "Check if a user ID is in the admin list (uses shared admin_user_ids)"

+fn handle_update (payload:String)->String [io,async]
  +if intake_mode!="webhook"
    +return "{}"
  +spawn process_update(payload)
  +return "{}"
+doc "Webhook intake: acknowledge immediately, process in background. Ignored unless intake_mode is 'webhook' so a stale route can't double-deliver while polling."

+fn poll_loop ()->String [io,async,mut]
  +if poll_running
    +return "already running"
  +set poll_running = true
  +while poll_running
    +await _:String = poll_once()
  +return "poll loop stopped"
+doc "Long-poll intake: repeatedly calls getUpdates. No inbound port required. Guarded by poll_running so it is started at most once."

+fn poll_once ()->String [io,async,mut]
  +let url:String = concat("https://api.telegram.org/bot", telegram_token, "/getUpdates?timeout=30&offset=", to_string(poll_offset))
  +match http_get(url)
  +case Ok(body)
    +await _:String = dispatch_updates(body)
    +return "ok"
  +case Err(e)
    +await _:Int = sleep(3000)
    +return concat("poll error: ", e)
+doc "One getUpdates cycle (30s long-poll). On network error, back off 3s and continue so the loop never crashes on a blip."

+fn dispatch_updates (body:String)->String [io,async,mut]
  +let arr:String = json_get(body, "result")
  +if arr==""
    +return "no result"
  +let n:Int = json_array_len(arr)
  +let i:Int = 0
  +while i<n
    +let update:String = json_get(arr, to_string(i))
    +let uid:Int = extract_update_id(update)
    +if uid>=poll_offset
      +set poll_offset = uid+1
    +spawn process_update(update)
    +set i = i+1
  +return concat("dispatched ", to_string(n))
+doc "Split a getUpdates array into individual updates, advance the dedup offset, and feed each to process_update (same path as webhook)."

+fn extract_update_id (update:String)->Int
  +let val:String = json_get(update, "update_id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract update_id for offset tracking (acknowledges the update so Telegram stops re-sending it)"

+test extract_update_id
  +with update="{\"update_id\":42,\"message\":{}}" -> expect 42
  +with update="{\"message\":{}}" -> expect 0

+fn extract_sender_name (payload:String)->String
  +let first_name:String = json_get(payload, "message.from.first_name")
  +let last_name:String = json_get(payload, "message.from.last_name")
  +let username:String = json_get(payload, "message.from.username")
  +let speaker_name:String = first_name
  +if last_name!=""
    +set speaker_name = concat(first_name, " ", last_name)
  +if speaker_name==""
    +set speaker_name = username
  +return speaker_name
+doc "The sender's display name: first+last, falling back to username, else empty. Shared by source_metadata and the group sender prefix so the name the model reads inline can never drift from the name recorded for provenance."

+test extract_sender_name
  +with payload="{\"message\":{\"from\":{\"first_name\":\"Kata\",\"last_name\":\"Example\"}}}" -> expect "Kata Example"
  +with payload="{\"message\":{\"from\":{\"first_name\":\"Kata\"}}}" -> expect "Kata"
  +with payload="{\"message\":{\"from\":{\"username\":\"marenz\"}}}" -> expect "marenz"
  +with payload="{\"message\":{\"from\":{\"id\":1}}}" -> expect ""

+fn format_sender (user_id:Int, name:String, text:String)->String
  +if name==""
    +return concat("[user:", to_string(user_id), "] ", text)
  +return concat("[user:", to_string(user_id), " ", name, "] ", text)
+doc "Build the sender-prefixed message the model sees in a group. The numeric id stays because it is stable and unspoofable; the display name is added because a model cannot address someone as @<number>, and pattern-matching a speaker from conversation history instead gets it wrong."

+test format_sender
  +with user_id=42 name="Kata Example" text="hi" -> expect "[user:42 Kata Example] hi"
  +with user_id=42 name="" text="hi" -> expect "[user:42] hi"

+fn describe_update_kind (payload:String)->String
  +let doc_name:String = json_get(payload, "message.document.file_name")
  +if doc_name!=""
    +return concat("user sent a file (", doc_name, ") which I cannot read")
  +let doc_id:String = json_get(payload, "message.document.file_id")
  +if doc_id!=""
    +return "user sent a file which I cannot read"
  +let sticker:String = json_get(payload, "message.sticker.file_id")
  +if sticker!=""
    +return concat("user sent a sticker ", json_get(payload, "message.sticker.emoji"))
  +let video:String = json_get(payload, "message.video.file_id")
  +if video!=""
    +return "user sent a video"
  +let video_note:String = json_get(payload, "message.video_note.file_id")
  +if video_note!=""
    +return "user sent a video note which I cannot watch"
  +let audio:String = json_get(payload, "message.audio.file_id")
  +if audio!=""
    +return "user sent an audio file which I cannot hear"
  +let animation:String = json_get(payload, "message.animation.file_id")
  +if animation!=""
    +return "user sent a GIF which I cannot watch"
  +let contact:String = json_get(payload, "message.contact.phone_number")
  +if contact!=""
    +return "user shared a contact"
  +let location:String = json_get(payload, "message.location.latitude")
  +if location!=""
    +return "user shared a location"
  +let poll:String = json_get(payload, "message.poll.question")
  +if poll!=""
    +return concat("user sent a poll: ", poll)
  +return ""
+doc "Describe a message that carries no text, image or voice, so it can be announced instead of silently dropped. A dropped update is invisible to the model, which then truthfully but uselessly reports an empty message. Returns empty only when the update has no recognisable content at all."

+test describe_update_kind
  +with payload="{\"message\":{\"sticker\":{\"file_id\":\"s\",\"emoji\":\"x\"}}}" -> expect "user sent a sticker x"
  +with payload="{\"message\":{\"video\":{\"file_id\":\"v\"}}}" -> expect "user sent a video"
  +with payload="{\"message\":{\"document\":{\"file_id\":\"d\",\"file_name\":\"notes.pdf\"}}}" -> expect "user sent a file (notes.pdf) which I cannot read"
  +with payload="{\"message\":{\"text\":\"hello\"}}" -> expect ""
  +with payload="{\"message\":{}}" -> expect ""

+fn speaker_principal (payload:String)->String
  +let user_id:Int = extract_user_id(payload)
  +if user_id==0
    +return ""
  +return concat("telegram:user:", to_string(user_id))
+doc "The sender's stable Ladybug principal. This is the ONLY identity channel: the model-facing [user:...] prefix is prose and must never be parsed back into an identity, because its format changes whenever the display format changes."

+test speaker_principal
  +with payload="{\"message\":{\"from\":{\"id\":456}}}" -> expect "telegram:user:456"
  +with payload="{\"message\":{}}" -> expect ""

+fn source_metadata (payload:String)->String
  +let message_id:String = to_string(json_get(payload, "message.message_id"))
  +let attachment_ref:String = extract_image_file_id(payload)
  +if attachment_ref==""
    +set attachment_ref = extract_video_file_id(payload)
  +if attachment_ref==""
    +set attachment_ref = json_get(payload, "message.voice.file_id")
  +let attachment_name:String = json_get(payload, "message.video.file_name")
  +if attachment_name==""
    +set attachment_name = json_get(payload, "message.document.file_name")
  +let attachment_mime:String = json_get(payload, "message.video.mime_type")
  +if attachment_mime==""
    +set attachment_mime = json_get(payload, "message.document.mime_type")
  +let attachment_duration:String = ""
  +if json_get(payload, "message.video.duration")!=""
    +set attachment_duration = to_string(json_get(payload, "message.video.duration"))
  +let attachment_size:String = ""
  +if json_get(payload, "message.video.file_size")!=""
    +set attachment_size = to_string(json_get(payload, "message.video.file_size"))
  +if attachment_size==""
    +if json_get(payload, "message.document.file_size")!=""
      +set attachment_size = to_string(json_get(payload, "message.document.file_size"))
  +let speaker_name:String = extract_sender_name(payload)
  +let speaker_id:String = speaker_principal(payload)
  +let created_at_ms:Int = to_int(to_string(json_get(payload, "message.date")))*1000
  +return concat("{\"message_id\":\"", json_escape(message_id), "\",\"speaker_id\":\"", json_escape(speaker_id), "\",\"speaker_name\":\"", json_escape(speaker_name), "\",\"created_at_ms\":", to_string(created_at_ms), ",\"attachment_ref\":\"", json_escape(attachment_ref), "\",\"attachment_name\":\"", json_escape(attachment_name), "\",\"attachment_mime\":\"", json_escape(attachment_mime), "\",\"attachment_duration_seconds\":\"", json_escape(attachment_duration), "\",\"attachment_size_bytes\":\"", json_escape(attachment_size), "\"}")
+doc "Preserve Telegram message identity, timestamp, speaker principal/display name and attachment file id/name/MIME/duration/size for Ladybug provenance. speaker_id is what the runtime resolves the principal from."

+test source_metadata
  +with payload="{\"message\":{\"message_id\":42,\"date\":1700000000,\"from\":{\"id\":456,\"first_name\":\"Kata\",\"last_name\":\"Example\"}}}" -> expect "{\"message_id\":\"42\",\"speaker_id\":\"telegram:user:456\",\"speaker_name\":\"Kata Example\",\"created_at_ms\":1700000000000,\"attachment_ref\":\"\",\"attachment_name\":\"\",\"attachment_mime\":\"\",\"attachment_duration_seconds\":\"\",\"attachment_size_bytes\":\"\"}"
  +with payload="{\"message\":{\"message_id\":7,\"date\":1700000000,\"from\":{\"id\":100000101},\"video\":{\"file_id\":\"vid-1\",\"file_name\":\"phone.mp4\",\"mime_type\":\"video/mp4\",\"duration\":12,\"file_size\":3456}}}" -> expect "{\"message_id\":\"7\",\"speaker_id\":\"telegram:user:100000101\",\"speaker_name\":\"\",\"created_at_ms\":1700000000000,\"attachment_ref\":\"vid-1\",\"attachment_name\":\"phone.mp4\",\"attachment_mime\":\"video/mp4\",\"attachment_duration_seconds\":\"12\",\"attachment_size_bytes\":\"3456\"}"

+fn process_update (payload:String)->String [io,async]
  +let text:String = extract_text(payload)
  +let chat_id:Int = extract_chat_id(payload)
  +let user_id:Int = extract_user_id(payload)
  +let chat_type:String = extract_chat_type(payload)
  +let metadata:String = source_metadata(payload)
  +let sender_name:String = extract_sender_name(payload)
  +let voice_file_id:String = json_get(payload, "message.voice.file_id")
  +let photo_file_id:String = extract_image_file_id(payload)
  +let video_file_id:String = extract_video_file_id(payload)
  +if chat_id==0
    +return "no chat_id"
  +let admin:Bool = is_admin(user_id)
  +let allowed:Bool = is_allowed(user_id)
  +if admin==false
    +if allowed==false
      +return concat("ignored: unauthorized user ", to_string(user_id))
  +if photo_file_id!=""
    +await file_path:String = telegram_file_path(photo_file_id)
    +if starts_with(file_path, "ERROR: ")
      +await _:String = send_message(chat_id, telegram_file_error_message(file_path, "photo"))
      +return "photo download failed"
    +if file_path==""
      +await _:String = send_message(chat_id, "I could not download that photo. Please try sending it again.")
      +return "photo download failed"
    +let download_url:String = concat("https://api.telegram.org/file/bot", telegram_token, "/", file_path)
    +await photo:Attachment = http_get_binary(download_url)
    +if chat_type=="group"
      +await _:String = handle_group_attachment(chat_id, user_id, sender_name, text, admin, photo, metadata)
      +return "ok"
    +if chat_type=="supergroup"
      +await _:String = handle_group_attachment(chat_id, user_id, sender_name, text, admin, photo, metadata)
      +return "ok"
    +if admin
      +await _:String = handle_admin_dm_attachment(chat_id, user_id, text, photo, metadata)
      +return "ok"
    +await _:String = handle_user_dm_attachment(chat_id, user_id, text, photo, metadata)
    +return "ok"
  +if video_file_id!=""
    +await file_path:String = telegram_file_path(video_file_id)
    +if starts_with(file_path, "ERROR: ")
      +await _:String = send_message(chat_id, telegram_file_error_message(file_path, "video"))
      +return "video download failed"
    +if file_path==""
      +await _:String = send_message(chat_id, "I could not download that video. Please send it again as a video or video document.")
      +return "video download failed"
    +let download_url:String = concat("https://api.telegram.org/file/bot", telegram_token, "/", file_path)
    +await video:Attachment = http_get_binary(download_url)
    +if text==""
      +set text = "[user sent a video; the original is available to video_stabilize()]"
    +if chat_type=="group"
      +await _:String = handle_group_attachment(chat_id, user_id, sender_name, text, admin, video, metadata)
      +return "ok"
    +if chat_type=="supergroup"
      +await _:String = handle_group_attachment(chat_id, user_id, sender_name, text, admin, video, metadata)
      +return "ok"
    +if admin
      +await _:String = handle_admin_dm_attachment(chat_id, user_id, text, video, metadata)
      +return "ok"
    +await _:String = handle_user_dm_attachment(chat_id, user_id, text, video, metadata)
    +return "ok"
  +if text==""
    +if voice_file_id!=""
      +await spoken:String = transcribe_voice(voice_file_id)
      +set text = spoken
  +if text==""
    +let kind:String = describe_update_kind(payload)
    +if kind==""
      +return "no recognisable content"
    +set text = concat("[", kind, "]")
  +if chat_type=="group"
    +await _:String = handle_group(chat_id, user_id, sender_name, text, admin, metadata)
    +return "ok"
  +if chat_type=="supergroup"
    +await _:String = handle_group(chat_id, user_id, sender_name, text, admin, metadata)
    +return "ok"
  +if admin
    +await _:String = handle_admin_dm(chat_id, user_id, text, metadata)
    +return "ok"
  +await _:String = handle_user_dm(chat_id, user_id, text, metadata)
  +return "ok"

+fn is_allowed (user_id:Int)->Bool
  +return is_admin_in(user_id, allowed_user_ids)
+doc "Check if a user ID is in the allow-list (allowed_user_ids); reuses the comma-boundary matcher."

+test is_allowed
  +with user_id=999 -> expect false

+fn handle_group (chat_id:Int, user_id:Int, sender_name:String, text:String, admin:Bool, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:group:", to_string(chat_id))
  +let sender:String = format_sender(user_id, sender_name, text)
  +let perm:String = ""
  +if admin==false
    +set perm = sandbox_perm_model
  +await reply:String = llm_takeover(ctx, sender, "TelegramBot.send_reply", to_string(chat_id), perm, metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"
+doc "Handle group/supergroup message. All messages share telegram:group:<chat_id> context, so the sender prefix carries both the stable numeric id and the display name — otherwise the model cannot tell who is speaking except by guessing from history. Non-admin senders get restricted permissions."

+fn handle_group_attachment (chat_id:Int, user_id:Int, sender_name:String, text:String, admin:Bool, attachment:Attachment, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:group:", to_string(chat_id))
  +let sender:String = format_sender(user_id, sender_name, text)
  +let perm:String = ""
  +if admin==false
    +set perm = sandbox_perm_model
  +await reply:String = llm_takeover(ctx, sender, "TelegramBot.send_reply", to_string(chat_id), perm, attachment, metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"
+doc "Handle a group photo or video with the same shared context, sender prefix and permissions as text."

+fn handle_admin_dm (chat_id:Int, user_id:Int, text:String, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), "", metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"

+fn handle_admin_dm_attachment (chat_id:Int, user_id:Int, text:String, attachment:Attachment, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), "", attachment, metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"

+fn handle_user_dm (chat_id:Int, user_id:Int, text:String, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:user:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), sandbox_perm_model, metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"
+doc "Handle DM from non-admin user. Sandboxed with restricted permission model."

+fn handle_user_dm_attachment (chat_id:Int, user_id:Int, text:String, attachment:Attachment, metadata:String)->String [io,async]
  +let ctx:String = concat("telegram:user:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), sandbox_perm_model, attachment, metadata)
  +if reply!=""
    +await _:String = send_message(chat_id, reply)
  +return "ok"
+doc "Handle a photo or video DM from a non-admin user with restricted permissions."

+fn telegram_file_path (file_id:String)->String [io,async]
  +let file_url:String = concat("https://api.telegram.org/bot", telegram_token, "/getFile?file_id=", file_id)
  +match http_get(file_url)
  +case Ok(file_info)
    +return telegram_file_path_response(file_info)
  +case Err(e)
    +return concat("ERROR: ", e)
+doc "Resolve a Telegram file ID to its downloadable path, preserving Telegram's actionable error text for the caller. Bot downloads are limited to 20 MB."

+fn telegram_file_path_response (file_info:String)->String
  +let file_path:String = json_get(file_info, "result.file_path")
  +if file_path!=""
    +return file_path
  +let description:String = json_get(file_info, "description")
  +if description!=""
    +return concat("ERROR: ", description)
  +return "ERROR: Telegram getFile returned no file path"
+doc "Extract a getFile path or preserve Telegram's JSON error description when HTTP 400 bodies are returned as ordinary response text."

+test telegram_file_path_response
  +with file_info="{\"ok\":true,\"result\":{\"file_path\":\"voice/file_42.oga\"}}" -> expect "voice/file_42.oga"
  +with file_info="{\"ok\":false,\"error_code\":400,\"description\":\"Bad Request: file is too big\",\"result\":{\"file_path\":\"\"}}" -> expect "ERROR: Bad Request: file is too big"

+fn telegram_file_error_message (error:String, kind:String)->String
  +if contains(error, "file is too big")
    +return concat("Telegram bots can only download files up to 20 MB. Please send a smaller ", concat(kind, "."))
  +return concat("I could not download that ", concat(kind, ". Please send it again."))
+doc "Turn Telegram getFile failures into user-facing guidance, including the platform's 20 MB bot-download cap."

+test telegram_file_error_message
  +with error="ERROR: HTTP 400 Bad Request: {\"description\":\"Bad Request: file is too big\"}" kind="video" -> expect "Telegram bots can only download files up to 20 MB. Please send a smaller video."
  +with error="ERROR: timeout" kind="photo" -> expect "I could not download that photo. Please send it again."

+fn transcribe_voice (file_id:String)->String [io,async]
  +let file_url:String = concat("https://api.telegram.org/bot", telegram_token, "/getFile?file_id=", file_id)
  +match http_get(file_url)
  +case Ok(file_info)
    +let file_path:String = json_get(file_info, "result.file_path")
    +if file_path==""
      +return "[voice message - could not get file]"
    +let download_url:String = concat("https://api.telegram.org/file/bot", telegram_token, "/", file_path)
    +await audio:Attachment = http_get_binary(download_url)
    +match http_upload("http://127.0.0.1:8090/transcribe", audio, "file", "")
    +case Ok(result)
      +return transcription_upload_response(Ok(result))
    +case Err(e)
      +return "[voice message - transcription failed]"
  +case Err(e)
    +return concat("[voice message - getFile failed: ", e, "]")

+fn transcription_upload_response (response:Result<String>)->String
  +match response
  +case Ok(body)
    +let transcript:String = json_get(body, "text")
    +if transcript==""
      +return "[voice message - transcription failed]"
    +return transcript
  +case Err(e)
    +return "[voice message - transcription failed]"
+doc "Extract a transcript from a successful ASR response while preserving the voice placeholder for HTTP/transport failures."

+test transcription_upload_response
  +with response=Ok("{\"text\":\"hello from ASR\"}") -> expect "hello from ASR"
  +with response=Err("HTTP upload failed with 503 Service Unavailable") -> expect "[voice message - transcription failed]"

+fn send_message (chat_id:Int, text:String)->String [io,async]
  +let url:String = concat("https://api.telegram.org/bot", telegram_token, "/sendMessage")
  +let body:String = concat("{\"chat_id\":", to_string(chat_id), ",\"text\":\"", json_escape(text), "\"}")
  +await response:String = http_post(url, body)
  +return response
+doc "Send a text message to a Telegram chat"

+fn send_reply (chat_id_str:String, text:String)->String [io,async]
  +let chat_id:Int = to_int(chat_id_str)
  +await resp:String = send_message(chat_id, text)
  +return resp
+doc "Send a text reply given chat_id as string (callback for llm_takeover)"

+fn send_reply_with_attachment (chat_id_str:String, text:String, attachment:Attachment)->Result<String> [io,async,fail]
  +let chat_id:Int = to_int(chat_id_str)
  +await _:String = send_message(chat_id, text)
  +let url:String = concat("https://api.telegram.org/bot", telegram_token, "/sendDocument")
  +let extra:String = concat("chat_id=", to_string(chat_id))
  +match http_upload(url, attachment, "document", extra)
  +case Ok(resp)
    +return resp
  +case Err(e)
    +check uploaded false ~err_attachment_delivery
+doc "Send a text reply with a file attachment via sendDocument (works for images, audio, pdfs — callback for llm_takeover/conversation_notify)"

+fn send_audio_file (chat_id:Int, file_path:String, caption:String)->String [io,async]
  +let url:String = concat("https://api.telegram.org/bot", telegram_token, "/sendDocument")
  +let extra:String = concat("chat_id=", to_string(chat_id), "&caption=", caption)
  +match http_upload(url, file_path, "document", extra)
  +case Ok(resp)
    +return resp
  +case Err(e)
    +return concat("ERROR: ", e)
+doc "Upload a local audio file to a Telegram chat"

+fn extract_chat_id (payload:String)->Int
  +let val:String = json_get(payload, "message.chat.id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract chat ID from Telegram webhook payload"

+test extract_chat_id
  +with payload="{\"message\":{\"chat\":{\"id\":123}}}" -> expect 123

+fn extract_user_id (payload:String)->Int
  +let val:String = json_get(payload, "message.from.id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract sender user ID from Telegram webhook payload"

+test extract_user_id
  +with payload="{\"message\":{\"from\":{\"id\":456}}}" -> expect 456
  +with payload="{\"message\":{}}" -> expect 0

+fn extract_chat_type (payload:String)->String
  +let val:String = json_get(payload, "message.chat.type")
  +return val
+doc "Extract chat type (private/group/supergroup/channel) from Telegram webhook payload"

+test extract_chat_type
  +with payload="{\"message\":{\"chat\":{\"type\":\"group\"}}}" -> expect "group"
  +with payload="{\"message\":{\"chat\":{\"type\":\"private\"}}}" -> expect "private"
  +with payload="{\"message\":{\"chat\":{}}}" -> expect ""

+fn extract_text (payload:String)->String
  +let val:String = json_get(payload, "message.text")
  +if val==""
    +return json_get(payload, "message.caption")
  +return val
+doc "Extract message text, falling back to a photo caption"

+test extract_text
  +with payload="{\"message\":{\"text\":\"hello\"}}" -> expect "hello"
  +with payload="{\"message\":{\"caption\":\"what is this?\"}}" -> expect "what is this?"
  +with payload="{\"message\":{}}" -> expect ""

+fn extract_image_file_id (payload:String)->String
  +let photos:String = json_get(payload, "message.photo")
  +if photos!=""
    +let n:Int = json_array_len(photos)
    +if n>0
      +let largest:String = json_get(photos, to_string(n-1))
      +return json_get(largest, "file_id")
  +let mime:String = json_get(payload, "message.document.mime_type")
  +if starts_with(mime, "image/")
    +return json_get(payload, "message.document.file_id")
  +return ""
+doc "Extract an image file ID from either Telegram's largest photo variant or an image document."

+test extract_image_file_id
  +with payload="{\"message\":{\"photo\":[{\"file_id\":\"small\"},{\"file_id\":\"large\"}]}}" -> expect "large"
  +with payload="{\"message\":{\"document\":{\"file_id\":\"doc\",\"mime_type\":\"image/png\"}}}" -> expect "doc"
  +with payload="{\"message\":{\"document\":{\"file_id\":\"pdf\",\"mime_type\":\"application/pdf\"}}}" -> expect ""
  +with payload="{\"message\":{}}" -> expect ""

+fn extract_video_file_id (payload:String)->String
  +let file_id:String = json_get(payload, "message.video.file_id")
  +if file_id!=""
    +return file_id
  +let mime:String = json_get(payload, "message.document.mime_type")
  +if starts_with(mime, "video/")
    +return json_get(payload, "message.document.file_id")
  +return ""
+doc "Extract a video file ID from Telegram's message.video object or a document whose MIME type starts with video/."

+test extract_video_file_id
  +with payload="{\"message\":{\"video\":{\"file_id\":\"phone\",\"mime_type\":\"video/mp4\"}}}" -> expect "phone"
  +with payload="{\"message\":{\"document\":{\"file_id\":\"doc\",\"mime_type\":\"video/quicktime\"}}}" -> expect "doc"
  +with payload="{\"message\":{\"document\":{\"file_id\":\"pdf\",\"mime_type\":\"application/pdf\"}}}" -> expect ""
  +with payload="{\"message\":{}}" -> expect ""

+fn extract_reply (json:String)->String
  +let val:String = json_get(json, "reply")
  +return val
+doc "Extract reply field from API response JSON"

+fn is_admin_in (user_id:Int, ids:String)->Bool
  +let uid_str:String = to_string(user_id)
  +let needle:String = concat(",", concat(uid_str, ","))
  +let haystack:String = concat(",", concat(ids, ","))
  +return contains(haystack, needle)
+doc "Check if user_id is in comma-separated ID list (testable pure version)"

+test is_admin_in
  +with user_id=100000001 ids="100000001" -> expect true
  +with user_id=9999999 ids="100000001" -> expect false
  +with user_id=100000001 ids="100000001,999" -> expect true
  +with user_id=999 ids="100000001,999" -> expect true
  +with user_id=99 ids="100000001,999" -> expect false
  +with user_id=181521 ids="100000001" -> expect false
