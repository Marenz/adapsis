+module TelegramBot
+type TgSendAttempt = TgSent(String) | TgRejected(String) | TgUncertain(String)
+type TgTextTurn = TgNoImmediateReply(String) | TgDeliveryAttempt(TgSendAttempt) | TgIgnored(String) | TgDeferred(String)
+shared telegram_token:String = ""
+shared admin_user_ids:String = "<redacted>"
+shared allowed_user_ids:String = ""
+shared sandbox_perm_model:String = "family"
+shared intake_mode:String = "poll"
+shared poll_offset:Int = 0
+fn telegram_upload_attempt (response:Result<String>)->TgSendAttempt
  +match response
  +case Ok(body)
    +if json_kind(body, "ok")!="bool"
      +return TgUncertain(body)
    +if to_string(json_get(body, "ok"))=="true"
      +return TgSent(body)
    +return TgRejected(body)
  +case Err(error)
    +return TgUncertain(error)
+fn send_reply_with_attachment (chat_id_str:String, text:String, attachment:Attachment)->TgSendAttempt [io,fail,async]
  +let chat_id:Int = to_int(chat_id_str)
  +if text!=""
    +await message_attempt:TgSendAttempt = TelegramBot.send_message(chat_id, text)
    +match message_attempt
    +case TgSent(_)
    +case _
      +return message_attempt
  +let url:String = concat("<redacted>", telegram_token, "/sendDocument")
  +let extra:String = concat("chat_id=", to_string(chat_id))
  +await response:Result<String> = http_upload(url, attachment, "document", extra)
  +return TelegramBot.telegram_upload_attempt(response)
+doc "Send nonempty text first; only confirmed Sent permits the single document upload. Empty text permits attachment-only delivery. Propagate upload outcome; callback acknowledgement remains separate (#104)."
+fn send_audio_file (chat_id:Int, file_path:String, caption:String)->TgSendAttempt [io,fail,async]
  +if contains(caption, "&")
    +return TgUncertain("caption contains unsupported multipart field delimiter")
  +let url:String = concat("<redacted>", telegram_token, "/sendDocument")
  +let extra:String = concat("chat_id=", to_string(chat_id), "&caption=", caption)
  +await response:Result<String> = http_upload(url, file_path, "document", extra)
  +return TelegramBot.telegram_upload_attempt(response)
+doc "Attempt one document upload from the existing path API. Captions containing ampersand are refused before IO because multipart extras cannot escape it (#106). No upload retry; callback ACK remains separate."
+fn extract_reply (json:String)->String
  +let val:String = json_get(json, "reply")
  +return val
+doc "Extract reply field from API response JSON"
+fn extract_update_id (update:String)->Int
  +let val:String = json_get(update, "update_id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract update_id for offset tracking (acknowledges the update so Telegram stops re-sending it)"
+fn init (token:String, admins:String)->String [mut]
  +set telegram_token = token
  +set admin_user_ids = admins
  +return "ok"
+doc "<redacted>"
+fn handle_update (payload:String)->String [io,async]
  +if intake_mode!="webhook"
    +return "{}"
  +spawn TelegramBot.process_update(payload)
  +return "{}"
+doc "Webhook intake: acknowledge immediately, process in background. Ignored unless intake_mode is 'webhook' so a stale route can't double-deliver while polling."
+fn batch_update_id_valid (batch:String, idx:String)->Bool
  +let path:String = concat(idx, ".update_id")
  +if json_kind(batch, path)!="int"
    +return false
  +let uid:Int = to_int(json_get(batch, path))
  +return uid>=0 AND uid<9223372036854775807
+fn dispatch_updates (body:String)->String [io,mut,async]
  +if json_kind(body, "result")!="array"
    +return "no result"
  +let arr:String = json_get(body, "result")
  +let n:Int = json_array_len(arr)
  +let i:Int = 0
  +let skipped:Int = 0
  +while i<n
    +let idx:String = to_string(i)
    +if TelegramBot.batch_update_id_valid(arr, idx)
      +let update:String = json_get(arr, idx)
      +let uid:Int = TelegramBot.extract_update_id(update)
      +if uid>=poll_offset
        +set poll_offset = uid+1
      +spawn TelegramBot.process_update(update)
    +else
      +set skipped = skipped+1
    +set i = i+1
  +if skipped>0
    +return concat("dispatched ", to_string(n-skipped), ", skipped ", to_string(skipped))
  +return concat("dispatched ", to_string(n))
+doc "Split a getUpdates array into individual updates, advance the dedup offset, and feed each to process_update (same path as webhook). Corrected port: a missing or non-array result returns 'no result'; updates without a represented update_id in 0..i64::MAX-1 are skipped without advancing or spawning; spawn stays fire-and-forget (at-most-once, no outcome, #104)."
+fn poll_once ()->String [io,mut,async]
  +let url:String = concat("<redacted>", telegram_token, "/getUpdates?timeout=30&offset=", to_string(poll_offset))
  +await response:Result<String> = http_get(url)
  +match response
  +case Ok(body)
    +if json_valid(body)==false
      +await _:Int = sleep(3000)
      +return "poll rejected: invalid body"
    +await outcome:String = TelegramBot.dispatch_updates(body)
    +if outcome=="no result"
      +await _:Int = sleep(3000)
      +return "poll rejected: no result"
    +if starts_with(outcome, "dispatched 0, skipped ")
      +await _:Int = sleep(3000)
      +return "poll rejected: no valid updates"
    +return "ok"
  +case Err(e)
    +await _:Int = sleep(3000)
    +return concat("poll error: ", e)
+doc "One getUpdates cycle (30s long-poll). Corrected port: explicit builtin Result binding; transport errors back off 3s; a 200 body that is not valid JSON, has no result array (e.g. Telegram 401/409 error JSON, which HttpGet delivers as Ok) or yields only skipped updates also backs off 3s instead of re-polling immediately or aborting; a genuine empty result array returns immediately. Dispatch is at-most-once (#104)."
+fn intake_validate (payload:String)->String
  +let objects:List<String> = list("message", "message.chat", "message.from")
  +let i:Int = 0
  +while i<len(objects)
    +let object_path:String = get(objects, i)
    +if json_kind(payload, object_path)!="object"
      +return "invalid required object"
    +set i = i+1
  +let ints:List<String> = list("message.chat.id", "message.from.id", "message.date")
  +set i = 0
  +while i<len(ints)
    +let int_path:String = get(ints, i)
    +if json_kind(payload, int_path)!="int"
      +return "invalid required integer"
    +set i = i+1
  +if to_int(json_get(payload, "message.chat.id"))==0 OR to_int(json_get(payload, "message.from.id"))<=0
    +return "invalid identity bounds"
  +let date:Int = to_int(json_get(payload, "message.date"))
  +if date<0 OR date>9223372036854775
    +return "invalid timestamp bounds"
  +if json_kind(payload, "message.chat.type")!="string"
    +return "invalid chat type"
  +let kind:String = json_get(payload, "message.chat.type")
  +if kind!="private" AND kind!="group" AND kind!="supergroup"
    +return "unsupported chat type"
  +set objects = list("video", "voice", "document", "sticker", "video_note", "audio", "animation", "contact", "location", "poll")
  +set i = 0
  +while i<len(objects)
    +let object_key:String = get(objects, i)
    +set kind = json_kind(payload, concat("message.", object_key))
    +if kind!="missing" AND kind!="object"
      +return "invalid media object"
    +set i = i+1
  +set kind = json_kind(payload, "message.photo")
  +if kind!="missing" AND kind!="array"
    +return "invalid photo array"
  +let error:String = TelegramBot.intake_validate_fields(payload)
  +if error!=""
    +return error
  +return TelegramBot.intake_validate_media(payload)
+fn intake_validate_fields (payload:String)->String
  +let kind:String = ""
  +let strings:List<String> = list("text", "caption", "from.first_name", "from.last_name", "from.username", "document.file_name", "document.mime_type", "document.file_id", "video.file_name", "video.mime_type", "video.file_id", "voice.file_id", "sticker.file_id", "sticker.emoji", "video_note.file_id", "audio.file_id", "animation.file_id", "contact.phone_number", "poll.question")
  +let i:Int = 0
  +while i<len(strings)
    +let string_key:String = get(strings, i)
    +set kind = json_kind(payload, concat("message.", string_key))
    +if kind!="missing" AND kind!="string"
      +return "invalid optional string"
    +set i = i+1
  +set kind = json_kind(payload, "message.message_id")
  +if kind!="missing" AND kind!="int"
    +return "invalid message id"
  +let numbers:List<String> = list("video.duration", "video.file_size", "document.file_size")
  +set i = 0
  +while i<len(numbers)
    +let number_key:String = get(numbers, i)
    +let path:String = concat("message.", number_key)
    +set kind = json_kind(payload, path)
    +if kind!="missing"
      +if kind!="int"
        +return "invalid numeric metadata"
      +if to_int(json_get(payload, path))<0
        +return "negative numeric metadata"
    +set i = i+1
  +set kind = json_kind(payload, "message.location.latitude")
  +if kind!="missing" AND kind!="int" AND kind!="float"
    +return "invalid location latitude"
  +return ""
+fn intake_validate_media (payload:String)->String
  +let path:String = ""
  +if json_kind(payload, "message.photo")=="array"
    +let photos:String = json_get(payload, "message.photo")
    +let count:Int = json_array_len(photos)
    +if count>0
      +set path = concat("message.photo.", to_string(count-1))
      +if json_kind(payload, path)!="object"
        +return "invalid selected photo"
      +set path = concat(path, ".file_id")
      +if json_kind(payload, path)!="string"
        +return "invalid selected photo id"
      +if json_get(payload, path)==""
        +return "empty selected photo id"
  +let native:List<String> = list("video", "voice")
  +let i:Int = 0
  +while i<len(native)
    +let native_key:String = get(native, i)
    +set path = concat("message.", native_key)
    +if json_kind(payload, path)=="object"
      +set path = concat(path, ".file_id")
      +if json_kind(payload, path)!="string"
        +return "missing selected media id"
      +if json_get(payload, path)==""
        +return "empty selected media id"
    +set i = i+1
  +let mime:String = json_get(payload, "message.document.mime_type")
  +if starts_with(mime, "image/") OR starts_with(mime, "video/")
    +if json_kind(payload, "message.document.file_id")!="string"
      +return "missing selected document id"
    +if json_get(payload, "message.document.file_id")==""
      +return "empty selected document id"
  +return ""
+fn describe_update_kind (payload:String)->String
  +let doc_name:String = json_get(payload, "message.document.file_name")
  +if doc_name!=""
    +return concat("user sent a file (", doc_name, ") which I cannot read")
  +let doc_id:String = json_get(payload, "message.document.file_id")
  +if doc_id!=""
    +return "user sent a file which I cannot read"
  +let sticker:String = json_get(payload, "message.sticker.file_id")
  +if sticker!=""
    +return concat("user sent a sticker ", json_get(payload, "message.sticker.emoji"))
  +let video:String = json_get(payload, "message.video.file_id")
  +if video!=""
    +return "user sent a video"
  +let video_note:String = json_get(payload, "message.video_note.file_id")
  +if video_note!=""
    +return "user sent a video note which I cannot watch"
  +let audio:String = json_get(payload, "message.audio.file_id")
  +if audio!=""
    +return "user sent an audio file which I cannot hear"
  +let animation:String = json_get(payload, "message.animation.file_id")
  +if animation!=""
    +return "user sent a GIF which I cannot watch"
  +let contact:String = json_get(payload, "message.contact.phone_number")
  +if contact!=""
    +return "user shared a contact"
  +let location:String = json_get(payload, "message.location.latitude")
  +if location!=""
    +return "user shared a location"
  +let poll:String = json_get(payload, "message.poll.question")
  +if poll!=""
    +return concat("user sent a poll: ", poll)
  +return ""
+doc "Describe a message that carries no text, image or voice, so it can be announced instead of silently dropped. A dropped update is invisible to the model, which then truthfully but uselessly reports an empty message. Returns empty only when the update has no recognisable content at all."
+fn process_update (payload:String)->TgTextTurn [io,fail,async]
  +let error:String = TelegramBot.intake_validate(payload)
  +if error!=""
    +return TgDeferred(error)
  +let text:String = TelegramBot.extract_text(payload)
  +let chat_id:Int = TelegramBot.extract_chat_id(payload)
  +let user_id:Int = TelegramBot.extract_user_id(payload)
  +let chat_type:String = TelegramBot.extract_chat_type(payload)
  +let admin:Bool = TelegramBot.is_admin(user_id)
  +let allowed:Bool = TelegramBot.is_allowed(user_id)
  +if admin==false AND allowed==false
    +return TgIgnored("unauthorized sender")
  +let metadata:String = TelegramBot.source_metadata(payload)
  +let sender_name:String = TelegramBot.extract_sender_name(payload)
  +let voice_file_id:String = json_get(payload, "message.voice.file_id")
  +let photo_file_id:String = TelegramBot.extract_image_file_id(payload)
  +let video_file_id:String = TelegramBot.extract_video_file_id(payload)
  +if photo_file_id!=""
    +await file_path:String = TelegramBot.telegram_file_path(photo_file_id)
    +if starts_with(file_path, "ERROR: ")
      +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, TelegramBot.telegram_file_error_message(file_path, "photo"))
      +return TgDeliveryAttempt(delivery)
    +if file_path==""
      +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, "I could not download that photo. Please try sending it again.")
      +return TgDeliveryAttempt(delivery)
    +let download_url:String = concat("<redacted>", telegram_token, "/", file_path)
    +await photo:Attachment = http_get_binary(download_url)
    +if chat_type=="group" OR chat_type=="supergroup"
      +await outcome:TgTextTurn = TelegramBot.handle_group_attachment(chat_id, user_id, sender_name, text, admin, photo, metadata)
      +return outcome
    +if admin
      +await outcome:TgTextTurn = TelegramBot.handle_admin_dm_attachment(chat_id, user_id, text, photo, metadata)
      +return outcome
    +await outcome:TgTextTurn = TelegramBot.handle_user_dm_attachment(chat_id, user_id, text, photo, metadata)
    +return outcome
  +if video_file_id!=""
    +await file_path:String = TelegramBot.telegram_file_path(video_file_id)
    +if starts_with(file_path, "ERROR: ")
      +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, TelegramBot.telegram_file_error_message(file_path, "video"))
      +return TgDeliveryAttempt(delivery)
    +if file_path==""
      +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, "I could not download that video. Please send it again as a video or video document.")
      +return TgDeliveryAttempt(delivery)
    +let download_url:String = concat("<redacted>", telegram_token, "/", file_path)
    +await video:Attachment = http_get_binary(download_url)
    +if text==""
      +set text = "[user sent a video; the original is available to video_stabilize()]"
    +if chat_type=="group" OR chat_type=="supergroup"
      +await outcome:TgTextTurn = TelegramBot.handle_group_attachment(chat_id, user_id, sender_name, text, admin, video, metadata)
      +return outcome
    +if admin
      +await outcome:TgTextTurn = TelegramBot.handle_admin_dm_attachment(chat_id, user_id, text, video, metadata)
      +return outcome
    +await outcome:TgTextTurn = TelegramBot.handle_user_dm_attachment(chat_id, user_id, text, video, metadata)
    +return outcome
  +if text==""
    +if voice_file_id!=""
      +await spoken:String = TelegramBot.transcribe_voice(voice_file_id)
      +set text = spoken
  +if text==""
    +let kind:String = TelegramBot.describe_update_kind(payload)
    +if kind==""
      +return TgIgnored("no recognisable content")
    +set text = concat("[", kind, "]")
  +if chat_type=="group" OR chat_type=="supergroup"
    +await outcome:TgTextTurn = TelegramBot.handle_group(chat_id, user_id, sender_name, text, admin, metadata)
    +return outcome
  +if admin
    +await outcome:TgTextTurn = TelegramBot.handle_admin_dm(chat_id, user_id, text, metadata)
    +return outcome
  +await outcome:TgTextTurn = TelegramBot.handle_user_dm(chat_id, user_id, text, metadata)
  +return outcome
+fn transcription_upload_response (response:Result<String>)->String
  +match response
  +case Ok(body)
    +if json_kind(body, "text")!="string"
      +return "[voice message - transcription failed]"
    +let transcript:String = json_get(body, "text")
    +if transcript==""
      +return "[voice message - transcription failed]"
    +return transcript
  +case Err(e)
    +return "[voice message - transcription failed]"
+doc "Extract a transcript from a successful ASR response while preserving the voice placeholder for HTTP/transport failures."
+fn transcribe_voice (file_id:String)->String [io,fail,async]
  +let file_url:String = concat("<redacted>", telegram_token, "/getFile?file_id=", file_id)
  +await file_response:Result<String> = http_get(file_url)
  +match file_response
  +case Ok(file_info)
    +if json_kind(file_info, "result.file_path")!="string"
      +return "[voice message - could not get file]"
    +let file_path:String = json_get(file_info, "result.file_path")
    +if file_path==""
      +return "[voice message - could not get file]"
    +let download_url:String = concat("<redacted>", telegram_token, "/", file_path)
    +await audio:Attachment = http_get_binary(download_url)
    +await upload_response:Result<String> = http_upload("http://127.0.0.1:8090/transcribe", audio, "file", "")
    +return TelegramBot.transcription_upload_response(upload_response)
  +case Err(e)
    +return concat("[voice message - getFile failed: ", e, "]")
+fn extract_chat_id (payload:String)->Int
  +let val:String = json_get(payload, "message.chat.id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract chat ID from Telegram webhook payload"
+fn extract_user_id (payload:String)->Int
  +let val:String = json_get(payload, "message.from.id")
  +if val==""
    +return 0
  +return to_int(val)
+doc "Extract sender user ID from Telegram webhook payload"
+fn extract_chat_type (payload:String)->String
  +let val:String = json_get(payload, "message.chat.type")
  +return val
+doc "Extract chat type (private/group/supergroup/channel) from Telegram webhook payload"
+fn extract_text (payload:String)->String
  +let val:String = json_get(payload, "message.text")
  +if val==""
    +return json_get(payload, "message.caption")
  +return val
+doc "Extract message text, falling back to a photo caption"
+fn extract_image_file_id (payload:String)->String
  +let photos:String = json_get(payload, "message.photo")
  +if photos!=""
    +let n:Int = json_array_len(photos)
    +if n>0
      +let largest:String = json_get(photos, to_string(n-1))
      +return json_get(largest, "file_id")
  +let mime:String = json_get(payload, "message.document.mime_type")
  +if starts_with(mime, "image/")
    +return json_get(payload, "message.document.file_id")
  +return ""
+doc "Extract an image file ID from either Telegram's largest photo variant or an image document."
+fn extract_video_file_id (payload:String)->String
  +let file_id:String = json_get(payload, "message.video.file_id")
  +if file_id!=""
    +return file_id
  +let mime:String = json_get(payload, "message.document.mime_type")
  +if starts_with(mime, "video/")
    +return json_get(payload, "message.document.file_id")
  +return ""
+doc "Extract a video file ID from Telegram's message.video object or a document whose MIME type starts with video/."
+fn format_sender (user_id:Int, name:String, text:String)->String
  +if name==""
    +return concat("[user:", to_string(user_id), "] ", text)
  +return concat("[user:", to_string(user_id), " ", name, "] ", text)
+doc "Build the sender-prefixed message the model sees in a group. The numeric id stays because it is stable and unspoofable; the display name is added because a model cannot address someone as @<number>, and pattern-matching a speaker from conversation history instead gets it wrong."
+fn is_admin_in (user_id:Int, ids:String)->Bool
  +let uid_str:String = to_string(user_id)
  +let needle:String = concat(",", concat(uid_str, ","))
  +let haystack:String = concat(",", concat(ids, ","))
  +return contains(haystack, needle)
+doc "Check if user_id is in comma-separated ID list (testable pure version)"
+fn telegram_response_ok (response:String)->Bool
  +return index_of(response, "\"ok\":true")>=0
+doc "True only when Telegram explicitly reported success. A missing ok:true - bad entities, a malformed body or a transport failure - counts as failure so the caller can fall back."
+fn telegram_file_path_response (file_info:String)->String
  +let file_path:String = json_get(file_info, "result.file_path")
  +if file_path!=""
    +return file_path
  +let description:String = json_get(file_info, "description")
  +if description!=""
    +return concat("ERROR: ", description)
  +return "ERROR: Telegram getFile returned no file path"
+doc "Extract a getFile path or preserve Telegram's JSON error description when HTTP 400 bodies are returned as ordinary response text."
+fn parse_id_list (raw:String)->String
  +let lines:List<String> = split(raw, "\n")
  +let out:String = ""
  +let i:Int = 0
  +let n:Int = len(lines)
  +while i<n
    +let line:String = get(lines, i)
    +let cells:List<String> = split(line, ",")
    +let j:Int = 0
    +let m:Int = len(cells)
    +while j<m
      +let tok:String = trim(get(cells, j))
      +if tok!=""
        +if starts_with(tok, "#")==false
          +if out==""
            +set out = tok
          +else
            +set out = concat(out, concat(",", tok))
      +set j = j+1
    +set i = i+1
  +return out
+doc "Normalize an ID file into a comma-separated ID string: accepts newline- and/or comma-separated IDs, trims whitespace, skips blank lines and # comments. Returns empty string if the file yields nothing (caller decides the fallback)."
+fn extract_sender_name (payload:String)->String
  +let first_name:String = json_get(payload, "message.from.first_name")
  +let last_name:String = json_get(payload, "message.from.last_name")
  +let username:String = json_get(payload, "message.from.username")
  +let speaker_name:String = first_name
  +if last_name!=""
    +set speaker_name = concat(first_name, " ", last_name)
  +if speaker_name==""
    +set speaker_name = username
  +return speaker_name
+doc "The sender's display name: first+last, falling back to username, else empty. Shared by source_metadata and the group sender prefix so the name the model reads inline can never drift from the name recorded for provenance."
+fn speaker_principal (payload:String)->String
  +let user_id:Int = TelegramBot.extract_user_id(payload)
  +if user_id==0
    +return ""
  +return concat("telegram:user:", to_string(user_id))
+doc "The sender's stable Ladybug principal. This is the ONLY identity channel: the model-facing [user:...] prefix is prose and must never be parsed back into an identity, because its format changes whenever the display format changes."
+fn source_metadata (payload:String)->String
  +let message_id:String = to_string(json_get(payload, "message.message_id"))
  +let attachment_ref:String = TelegramBot.extract_image_file_id(payload)
  +if attachment_ref==""
    +set attachment_ref = TelegramBot.extract_video_file_id(payload)
  +if attachment_ref==""
    +set attachment_ref = json_get(payload, "message.voice.file_id")
  +let attachment_name:String = json_get(payload, "message.video.file_name")
  +if attachment_name==""
    +set attachment_name = json_get(payload, "message.document.file_name")
  +let attachment_mime:String = json_get(payload, "message.video.mime_type")
  +if attachment_mime==""
    +set attachment_mime = json_get(payload, "message.document.mime_type")
  +let attachment_duration:String = ""
  +if json_get(payload, "message.video.duration")!=""
    +set attachment_duration = to_string(json_get(payload, "message.video.duration"))
  +let attachment_size:String = ""
  +if json_get(payload, "message.video.file_size")!=""
    +set attachment_size = to_string(json_get(payload, "message.video.file_size"))
  +if attachment_size==""
    +if json_get(payload, "message.document.file_size")!=""
      +set attachment_size = to_string(json_get(payload, "message.document.file_size"))
  +let speaker_name:String = TelegramBot.extract_sender_name(payload)
  +let speaker_id:String = TelegramBot.speaker_principal(payload)
  +let created_at_ms:Int = to_int(to_string(json_get(payload, "message.date")))*1000
  +return concat("{\"message_id\":\"", json_escape(message_id), "\",\"speaker_id\":\"", json_escape(speaker_id), "\",\"speaker_name\":\"", json_escape(speaker_name), "\",\"created_at_ms\":", to_string(created_at_ms), ",\"attachment_ref\":\"", json_escape(attachment_ref), "\",\"attachment_name\":\"", json_escape(attachment_name), "\",\"attachment_mime\":\"", json_escape(attachment_mime), "\",\"attachment_duration_seconds\":\"", json_escape(attachment_duration), "\",\"attachment_size_bytes\":\"", json_escape(attachment_size), "\"}")
+doc "Preserve Telegram message identity, timestamp, speaker principal/display name and attachment file id/name/MIME/duration/size for Ladybug provenance. speaker_id is what the runtime resolves the principal from."
+fn send_message_body (chat_id:Int, text:String, html:Bool)->String
  +if html
    +return concat("{\"chat_id\":", to_string(chat_id), ",\"text\":\"", json_escape(text), "\",\"parse_mode\":\"HTML\"}")
  +return concat("{\"chat_id\":", to_string(chat_id), ",\"text\":\"", json_escape(text), "\"}")
+doc "Build the sendMessage JSON body for either HTML-parsed or plain text."
+fn send_message_part (chat_id:Int, text:String, html:Bool)->TgSendAttempt [io,fail,async]
  +let url:String = concat("<redacted>", telegram_token, "/sendMessage")
  +await response:Result<String> = http_post(url, TelegramBot.send_message_body(chat_id, text, html))
  +match response
  +case Ok(body)
    +let status:String = to_string(json_get(body, "ok"))
    +if status=="true"
      +return TgSent(body)
    +end
    +if status=="false"
      +return TgRejected(body)
    +end
    +return TgUncertain(body)
  +case Err(error)
    +return TgUncertain(error)
  +end
+end
+doc "Send one attempt. Only a parsed Boolean ok field classifies Sent/Rejected; transport errors or nonboolean status are Uncertain. Malformed JSON raises a terminal parse error. No resend occurs here."
+fn send_message_parts (chat_id:Int, parts:List<String>, i:Int, last:String)->TgSendAttempt [io,fail,async]
  +if i<0 OR i>=len(parts)
    +return TgUncertain("no chunk at index")
  +end
  +let part:String = get(parts, i)
  +await attempt:TgSendAttempt = TelegramBot.send_message_part(chat_id, part, true)
  +match attempt
  +case TgRejected(_)
    +await attempt:TgSendAttempt = TelegramBot.send_message_part(chat_id, part, false)
  +case _
  +end
  +match attempt
  +case TgSent(body)
    +if i+1>=len(parts)
      +return attempt
    +end
    +await following:TgSendAttempt = TelegramBot.send_message_parts(chat_id, parts, i+1, body)
    +return following
  +case TgRejected(_)
    +return attempt
  +case TgUncertain(_)
    +return attempt
  +end
+end
+doc "Attempt chunks in order. Only confirmed Boolean false permits one plain fallback; uncertainty or rejection of that fallback stops remaining chunks. Sent requires a confirmed attempt. The legacy last parameter cannot manufacture success and is retained only for input compatibility."
+fn send_message (chat_id:Int, text:String)->TgSendAttempt [io,fail,async]
  +let html:String = TgFormat.markdown_to_html(text)
  +let parts:List<String> = TgFormat.split_for_telegram(html, 3800)
  +await outcome:TgSendAttempt = TelegramBot.send_message_parts(chat_id, parts, 0, "")
  +return outcome
+end
+doc "Format and split text, then propagate the send-chain outcome unchanged without another retry. The inherited splitter is not service-limit safe (#99)."
+fn send_reply (chat_id_str:String, text:String)->TgSendAttempt [io,fail,async]
  +let chat_id:Int = to_int(chat_id_str)
  +await outcome:TgSendAttempt = TelegramBot.send_message(chat_id, text)
  +return outcome
+end
+doc "Parse the destination and propagate the message outcome unchanged. This callable contract does not certify callback delivery acknowledgement."
+fn is_admin (user_id:Int)->Bool
  +return TelegramBot.is_admin_in(user_id, admin_user_ids)
+doc "Check if a user ID is in the admin list (uses shared admin_user_ids)"
+fn is_allowed (user_id:Int)->Bool
  +return TelegramBot.is_admin_in(user_id, allowed_user_ids)
+doc "Check if a user ID is in the allow-list (allowed_user_ids); reuses the comma-boundary matcher."
+fn handle_group (chat_id:Int, user_id:Int, sender_name:String, text:String, admin:Bool, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:group:", to_string(chat_id))
  +let sender:String = TelegramBot.format_sender(user_id, sender_name, text)
  +let perm:String = ""
  +if admin==false
    +set perm = sandbox_perm_model
  +end
  +await reply:String = llm_takeover(ctx, sender, "TelegramBot.send_reply", to_string(chat_id), perm, metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve group takeover arguments and wrap the immediate send outcome without discarding failure. Empty reply is not delivery acknowledgement; #104 remains open."
+fn handle_admin_dm (chat_id:Int, user_id:Int, text:String, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), "", metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve admin DM takeover arguments and propagate immediate delivery outcome. NoImmediateReply is not callback success."
+fn handle_user_dm (chat_id:Int, user_id:Int, text:String, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:user:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), sandbox_perm_model, metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve sandboxed DM takeover arguments and propagate immediate delivery outcome. NoImmediateReply is not callback success."
+fn process_text_update (payload:String)->TgTextTurn [io,fail,async]
  +if json_kind(payload, "message.chat.id")!="int"
    +return TgIgnored("invalid chat id")
  +end
  +let chat_id:Int = to_int(json_get(payload, "message.chat.id"))
  +if chat_id==0
    +return TgIgnored("invalid chat id")
  +end
  +if json_kind(payload, "message.from.id")!="int"
    +return TgIgnored("invalid sender id")
  +end
  +let user_id:Int = to_int(json_get(payload, "message.from.id"))
  +if user_id<=0
    +return TgIgnored("invalid sender id")
  +end
  +if json_kind(payload, "message.date")!="int"
    +return TgIgnored("invalid date")
  +end
  +let date:Int = to_int(json_get(payload, "message.date"))
  +if date<0
    +return TgIgnored("invalid date")
  +end
  +if json_kind(payload, "message.chat.type")!="string"
    +return TgIgnored("unsupported chat type")
  +end
  +let chat_type:String = TelegramBot.extract_chat_type(payload)
  +if contains(list("private", "group", "supergroup"), chat_type)==false
    +return TgIgnored("unsupported chat type")
  +end
  +let media:List<String> = list("photo", "video", "voice", "document", "audio", "animation", "sticker", "video_note", "contact", "location", "poll")
  +let i:Int = 0
  +while i<len(media)
    +let media_key:String = get(media, i)
    +if json_kind(payload, concat("message.", media_key))!="missing"
      +return TgDeferred("media path pending")
    +end
    +set i = i+1
  +end
  +let text_kind:String = json_kind(payload, "message.text")
  +if text_kind=="missing"
    +return TgIgnored("no text")
  +end
  +if text_kind!="string"
    +return TgDeferred("non-string text")
  +end
  +let text:String = json_get(payload, "message.text")
  +if text==""
    +return TgIgnored("no text")
  +end
  +let admin:Bool = TelegramBot.is_admin(user_id)
  +let allowed:Bool = TelegramBot.is_allowed(user_id)
  +if admin==false AND allowed==false
    +return TgIgnored("unauthorized sender")
  +end
  +let metadata:String = TelegramBot.source_metadata(payload)
  +let sender_name:String = TelegramBot.extract_sender_name(payload)
  +if chat_type=="group" OR chat_type=="supergroup"
    +await outcome:TgTextTurn = TelegramBot.handle_group(chat_id, user_id, sender_name, text, admin, metadata)
    +return outcome
  +end
  +if admin
    +await outcome:TgTextTurn = TelegramBot.handle_admin_dm(chat_id, user_id, text, metadata)
    +return outcome
  +end
  +await outcome:TgTextTurn = TelegramBot.handle_user_dm(chat_id, user_id, text, metadata)
  +return outcome
+end
+doc "NEW partial text-only entry, not process_update parity. json_kind validates exact ID/date/text/chat types and media presence before conversion, authorization and IO. Any present media defers; legitimate JSON-looking Strings remain text. Structured from.id determines authority; callback acknowledgement is not certified."
+fn telegram_file_path (file_id:String)->String [io,fail,async]
  +let file_url:String = concat("<redacted>", telegram_token, "/getFile?file_id=", file_id)
  +await response:Result<String> = http_get(file_url)
  +match response
  +case Ok(file_info)
    +return TelegramBot.telegram_file_path_response(file_info)
  +case Err(e)
    +return concat("ERROR: ", e)
  +end
+end
+doc "Preserve the original getFile path/error-String contract using explicit builtin Result binding and matching. Malformed JSON remains terminal; no binary download occurs here."
+fn telegram_file_error_message (error:String, kind:String)->String
  +if contains(error, "file is too big")
    +return concat("Telegram bots can only download files up to 20 MB. Please send a smaller ", concat(kind, "."))
  +return concat("I could not download that ", concat(kind, ". Please send it again."))
+doc "Turn Telegram getFile failures into user-facing guidance, including the platform's 20 MB bot-download cap."
+fn handle_group_attachment (chat_id:Int, user_id:Int, sender_name:String, text:String, admin:Bool, attachment:Attachment, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:group:", to_string(chat_id))
  +let sender:String = TelegramBot.format_sender(user_id, sender_name, text)
  +let perm:String = ""
  +if admin==false
    +set perm = sandbox_perm_model
  +end
  +await reply:String = llm_takeover(ctx, sender, "TelegramBot.send_reply", to_string(chat_id), perm, attachment, metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve the group attachment takeover request and propagate immediate delivery outcome without another retry. Callback acknowledgement remains unverified (#104)."
+fn handle_admin_dm_attachment (chat_id:Int, user_id:Int, text:String, attachment:Attachment, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), "", attachment, metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve admin attachment takeover arguments and propagate immediate delivery outcome. NoImmediateReply is not callback success."
+fn handle_user_dm_attachment (chat_id:Int, user_id:Int, text:String, attachment:Attachment, metadata:String)->TgTextTurn [io,fail,async]
  +let ctx:String = concat("telegram:user:", to_string(user_id))
  +await reply:String = llm_takeover(ctx, text, "TelegramBot.send_reply", to_string(chat_id), sandbox_perm_model, attachment, metadata)
  +if reply!=""
    +await delivery:TgSendAttempt = TelegramBot.send_message(chat_id, reply)
    +return TgDeliveryAttempt(delivery)
  +end
  +return TgNoImmediateReply("no immediate reply")
+end
+doc "Preserve sandboxed attachment takeover arguments and propagate immediate delivery outcome. NoImmediateReply is not callback success."
